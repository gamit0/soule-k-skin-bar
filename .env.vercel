# =============================================================================
# .env.vercel — Variables de entorno para Vercel (Production / Preview / Dev)
# =============================================================================
# Copia este archivo a tu dashboard de Vercel → Settings → Environment Variables
# y reemplaza cada [PLACEHOLDER] por el valor real.
#
# Convención:
#   NEXT_PUBLIC_*  → variables expuestas al cliente (browser). Suben al bundle.
#   Sin prefijo     → variables solo del lado del servidor (serverless functions).
#
# Para subir masivamente usa:
#   vercel env add .env.vercel production preview development
# =============================================================================

# --- Entorno ---
NODE_ENV=production

# --- Base de datos (PostgreSQL - Supabase) ---
# Connection string del pooler (puerto 6543) para entornos serverless.
# Consigue la URL real en: Supabase → Settings → Database → Connection strings → "Pooler"
DATABASE_URL="postgres://postgres.[id]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# --- Supabase (client-side) ---
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[id].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon_key]"

# --- Supabase (server-side) ---
# Supabase → Settings → API → "service_role" key (SECRETA, no exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY="[service_role_key]"
SUPABASE_SECRET_KEY="[secret_key]"
SUPABASE_JWT_SECRET="[jwt_secret]"

# --- Auth.js (NextAuth) ---
# Genera con: openssl rand -base64 33
AUTH_SECRET="[generate-a-random-string-33-chars]"

# Google OAuth (opcional — si no se configura, solo queda login con email/contraseña)
# Google Cloud Console → Credentials → OAuth 2.0 Client ID
AUTH_GOOGLE_ID="[google_client_id]"
AUTH_GOOGLE_SECRET="[google_client_secret]"

# Admin bootstrap (crea el primer super_admin si la tabla está vacía)
FIRST_ADMIN_EMAIL="admin@tudominio.com"
FIRST_ADMIN_PASSWORD="password-seguro-123"

# --- IA (Google Gemini) ---
# Google AI Studio → Create API Key → Gemini
GEMINI_API_KEY="[your_gemini_api_key]"

# --- Stripe (pagos) ---
# Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY="[stripe_secret_key]"
STRIPE_WEBHOOK_SECRET="[stripe_webhook_secret]"
# Clave publica, segura para exponer al cliente
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="[stripe_publishable_key]"

# --- WhatsApp (contacto) ---
# Número con código de país, SIN '+' ni espacios. Ej: México → 521234567890
NEXT_PUBLIC_WHATSAPP_NUMBER="521234567890"

# --- N8N chatbot (webhook) ---
# URL del webhook de n8n que recibe los msgs del chatbot
NEXT_PUBLIC_N8N_WEBHOOK_URL="https://tu-n8n.example.com/webhook/chat"

# --- Sitio (SEO / sitemap / robots) ---
# Dominio real production
NEXT_PUBLIC_SITE_URL="https://soulekskinbar.com"

# --- Upstash Redis (rate limiting distribuido) ---
# Upstash → Redis → REST API (para que el rate limit funcione entre múltiples
# instancias serverless de Vercel; sin esto cae a un fallback in-memory por instancia)
UPSTASH_REDIS_REST_URL="[upstash_redis_rest_url]"
UPSTASH_REDIS_REST_TOKEN="[upstash_redis_rest_token]"

# --- Storage S3-compatible (futuro) ---
S3_ENDPOINT="[endpoint]"
S3_BUCKET="[bucket]"
S3_ACCESS_KEY_ID="[access_key]"
S3_SECRET_ACCESS_KEY="[secret_key]"