# Base de datos (PostgreSQL - Supabase)
# Usa el connection string del pooler (puerto 6543) para entornos serverless/producción
DATABASE_URL="postgres://postgres.[id]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase Additional Keys
NEXT_PUBLIC_SUPABASE_URL="https://[id].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon_key]"
SUPABASE_SERVICE_ROLE_KEY="[service_role_key]"
SUPABASE_SECRET_KEY="[secret_key]"
SUPABASE_JWT_SECRET="[jwt_secret]"

# Auth.js
NEXTAUTH_SECRET="[generate-a-random-string]"
AUTH_GOOGLE_ID="[google_client_id]"
AUTH_GOOGLE_SECRET="[google_client_secret]"

# Admin bootstrap (para crear el primer super_admin)
FIRST_ADMIN_EMAIL="admin@tudominio.com"
FIRST_ADMIN_PASSWORD="password-seguro-123"

# AI (Gemini)
GEMINI_API_KEY="[your_gemini_api_key]"

# Stripe (Fase 6)
STRIPE_SECRET_KEY="[stripe_secret]"
STRIPE_WEBHOOK_SECRET="[stripe_webhook]"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="[stripe_pub_key]"

# WhatsApp (Fase 10) - Deep link (actual)
NEXT_PUBLIC_WHATSAPP_NUMBER="[number_with_country_code]"

# WhatsApp Cloud API (Meta Graph API) - Para automatización completa
# WHATSAPP_ACCESS_TOKEN="[access_token_from_meta]"           # Token permanente de System User
# WHATSAPP_PHONE_NUMBER_ID="[phone_number_id]"                # ID numérico del teléfono en Meta
# WHATSAPP_API_VERSION="v20.0"                                # Versión Graph API (opcional)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN="[random_verify_token]"       # Token para verificación webhook
# N8N_WHATSAPP_WEBHOOK_URL="https://tu-n8n.app.n8n.cloud/webhook/WHATSAPP_WEBHOOK_ID"
# N8N_WEBHOOK_AUTH_TOKEN="[optional_auth_for_n8n_webhook]"    # Si n8n requiere auth

# n8n Integration (server-only, never NEXT_PUBLIC_)
N8N_API_KEY="[generate-secure-random-string]"

# Storage S3-compatible (Fase 3+)
S3_ENDPOINT="[endpoint]"
S3_BUCKET="[bucket]"
S3_ACCESS_KEY_ID="[access_key]"
S3_SECRET_ACCESS_KEY="[secret_key]"
